; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Beyond_The_Screen"
run/main_scene="res://scenes/main/game.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="res://resources/audio/default_bus_layout.tres"

[autoload]

SceneTransistor="*res://scenes/ui/transitions/scene_transistor.tscn"
GameManager="*res://globals/game_manager.gd"
VideoSceneTransistor="*res://scenes/ui/transitions/video_scene_transistor.tscn"
Dialogic="*uid://ds2q0uclmolvu"
_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"
DialogicBridge="*res://globals/dialogic_bridge.gd"

[dialogic]

directories/dch_directory={
"campesino": "res://dialogues/characters/campesino.dch",
"chico_moreno": "res://dialogues/characters/chico_moreno.dch",
"ellen": "res://dialogues/characters/ellen.dch",
"encapuchado": "res://dialogues/characters/encapuchado.dch",
"herrero": "res://dialogues/characters/herrero.dch",
"kael": "res://dialogues/characters/kael.dch",
"leo": "res://dialogues/characters/leo.dch",
"mini_bot": "res://dialogues/characters/mini_bot.dch",
"silla_ruedas": "res://dialogues/characters/silla_ruedas.dch",
"smoker": "res://dialogues/characters/smoker.dch",
"toren": "res://dialogues/characters/toren.dch",
"val": "res://dialogues/characters/val.dch"
}
directories/dtl_directory={
"campesino": "res://dialogues/timelines/campesino.dtl",
"chico_moreno": "res://dialogues/timelines/chico_moreno.dtl",
"encapuchado": "res://dialogues/timelines/encapuchado.dtl",
"herrero": "res://dialogues/timelines/herrero.dtl",
"mini_robot": "res://dialogues/timelines/mini_robot.dtl",
"mini_robot_2": "res://dialogues/timelines/mini_robot_2.dtl",
"mini_robot_3": "res://dialogues/timelines/mini_robot_3.dtl",
"pink_girl": "res://dialogues/timelines/pink_girl.dtl",
"robot_grande": "res://dialogues/timelines/robot_grande.dtl",
"silla_ruedas": "res://dialogues/timelines/silla_ruedas.dtl",
"smoker": "res://dialogues/timelines/smoker.dtl",
"tavern_maid": "res://dialogues/timelines/tavern_maid.dtl",
"tavern_maid_town": "res://dialogues/timelines/tavern_maid_town.dtl",
"young_cyborg": "res://dialogues/timelines/young_cyborg.dtl"
}
layout/style_directory={
"": "res://resources/dialogues/vn_style_dialogic.tres",
"vn_style_dialogic": "res://resources/dialogues/vn_style_dialogic.tres"
}
text/letter_speed=0.01
text/initial_text_reveal_skippable=true
text/text_reveal_skip_delay=0.1
text/advance_delay=0.1
text/autoadvance_per_character_delay=0.1
text/autoadvance_ignored_characters_enabled=true
animations/join_default_length=0.5
animations/join_default_wait=true
animations/leave_default_length=0.5
animations/leave_default_wait=true
animations/cross_fade_default_length=0.5
choices/autofocus_first=true
choices/delay=0.2
choices/reveal_delay=0
choices/reveal_by_input=false
save/autosave_delay=60.0
save/encryption_on_exports_only=true
text/autopauses={}
audio/channel_defaults={
"": {
"audio_bus": "",
"fade_length": 0.0,
"loop": false,
"volume": 0.0
},
"music": {
"audio_bus": "",
"fade_length": 0.0,
"loop": true,
"volume": 0.0
}
}
layout/style_list=["res://resources/dialogues/vn_style_dialogic.tres"]
layout/default_style="res://resources/dialogues/vn_style_dialogic.tres"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
mouse_cursor/custom_image="uid://0jdoqrlr71q6"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogic/plugin.cfg", "res://addons/godot_ai/plugin.cfg")

[global_group]

player=""

